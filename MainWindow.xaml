<Window x:Class="lab_9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Master" 
        MinHeight="450" MinWidth="400" 
        Height="500" Width="500"
        Background="#F5F5F7" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Height" Value="35"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="ТЕКУЩЕЕ ВРЕМЯ" FontSize="10" Foreground="Gray" 
                           HorizontalAlignment="Center" FontWeight="Bold" />
                <TextBlock x:Name="LblCurrentTime" Text="00:00" 
                           FontFamily="Consolas" Foreground="#2C3E50" HorizontalAlignment="Center"/>
            </StackPanel>
        </Viewbox>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Установить:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <TextBox x:Name="TxtHours" Width="40" FontSize="14" Text="12" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <TextBlock Text=":" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0"/>
                    <TextBox x:Name="TxtMinutes" Width="40" FontSize="14" Text="00" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Content="Применить" Click="BtnCreate_Click" Margin="15,0,0,0" Padding="15,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Минуты для операций:" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                <TextBox x:Name="TxtValue" Width="80" FontSize="18" Text="15" 
                         HorizontalContentAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="2">
                <Button Content="+ добавить" Click="BtnAdd_Click" FontSize="16"/>
                <Button Content="- вычесть" Click="BtnSub_Click" FontSize="16"/>
                <Button Content="Минута ++" Click="BtnInc_Click" FontSize="16"/>
                <Button Content="Минута --" Click="BtnDec_Click" FontSize="16"/>
            </UniformGrid>
        </Grid>

        <UniformGrid Grid.Row="3" Columns="2" Margin="0,10">
            <Button Content="Часов? (byte)" Style="{StaticResource SmallButtonStyle}" Click="BtnToByte_Click"/>
            <Button Content="Полночь? (bool)" Style="{StaticResource SmallButtonStyle}" Click="BtnToBool_Click"/>
        </UniformGrid>

        <TextBlock x:Name="TxtStatus" Grid.Row="4" Text="Готов к работе" 
                   FontSize="12" Foreground="DimGray" HorizontalAlignment="Center" Margin="0,5"/>
    </Grid>
</Window>